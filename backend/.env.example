# Go backend — copy to .env and fill in
PORT=8080

# Supabase -> Settings -> Database -> Connection string (URI, session pooler ok)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Supabase -> Settings -> API -> JWT Secret (used to verify access tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Google Gemini API key for AI features (https://aistudio.google.com/apikey)
# Leave empty to use the built-in mock provider (demo mode)
GEMINI_API_KEY=your-gemini-api-key

# Frontend dev server origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
